# Copy to .env.local for `next dev`, or provide via your deployment's env
# (see docker-compose.yml for production).

# Credentials for the single admin account at /[lang]/admin — there is no
# sign-up flow, this is the only login this app will ever have.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Random secret used to sign the admin session cookie (JWT). Generate one with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Where template metadata + uploaded files (json + preview images) are
# stored on disk. Leave unset for local dev (defaults to ./.data/templates).
# In Docker this must point at the mounted volume — see docker-compose.yml.
# TEMPLATES_DATA_DIR=/data/templates
